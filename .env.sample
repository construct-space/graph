# Environment for graph. Copy to .env and fill in real values; secrets say change-me.
DATABASE_URL=postgres://user:change-me@localhost:5432/construct_graph?sslmode=disable
PORT=80
ACCOUNTS_URL=http://accounts
DEV_PORTAL_URL=http://developer
OAUTH_URL=https://accounts.construct.space
OAUTH_CLIENT_ID=construct_graph
OAUTH_CLIENT_SECRET=change-me
OAUTH_REDIRECT_URI=https://graph.construct.space/api/auth/callback
APP_URL=https://graph.construct.space
INTERNAL_SHARED_SECRET=change-me
